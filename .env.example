# Variables lues par docker-compose.yml (via un fichier ".env" à la racine,
# non versionné). Copier ce fichier en ".env" et remplir les vraies valeurs
# avant "docker compose up".

POSTGRES_USER=dispouser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dispoconduite

# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Domaine réel du frontend une fois déployé (derrière HTTPS en prod — les
# cookies de session ne partent qu'en HTTPS dès que NODE_ENV=production).
CORS_ORIGINS=https://ton-domaine.example
FRONTEND_URL=https://ton-domaine.example

# URL publique du backend, telle qu'appelée par le navigateur — baked dans
# le build du frontend (Vite), donc à définir AVANT "docker compose build".
VITE_API_URL=https://ton-domaine.example/api

# Optionnel — sans clé, les emails sont juste loggués, pas envoyés.
RESEND_API_KEY=

STYCH_POLL_INTERVAL_MINUTES=10
