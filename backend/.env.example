DATABASE_URL=postgresql://dispouser:dispopass@localhost:5434/dispoconduite
JWT_SECRET=change-me
PORT=3000
CORS_ORIGINS=http://localhost:5173
RESEND_API_KEY=
# Domaine d'expédition des emails — doit être vérifié dans Resend.
EMAIL_FROM_DOMAIN=dispoconduite.fr
FRONTEND_URL=http://localhost:5173

# Identifiants du compte élève Stych (V0 : un seul compte, le tien).
# Le mot de passe ne sert qu'à la connexion initiale : le connecteur
# stocke ensuite le cookie de session + token_csrf, jamais le mot de passe en clair.
STYCH_EMAIL=
STYCH_PASSWORD=

# Intervalle de veille en minutes (recommandation cahier des charges : 5-15 min)
STYCH_POLL_INTERVAL_MINUTES=10
