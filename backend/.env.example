DATABASE_URL=postgresql://dispouser:dispopass@localhost:5434/dispoconduite
JWT_SECRET=change-me
PORT=3000
CORS_ORIGINS=http://localhost:5173
RESEND_API_KEY=
# Domaine d'expédition des emails — doit être vérifié dans Resend.
EMAIL_FROM_DOMAIN=dispoconduite.fr
FRONTEND_URL=http://localhost:5173

# Identifiants du compte élève Stych (V0 : un seul compte, le tien) — utilisés
# pour le relogin scripté automatique quand la session expire (voir
# StychService.tryAutoRelogin), pas seulement à la connexion initiale.
STYCH_EMAIL=
STYCH_PASSWORD=
# token_csrf observé stable dans le temps (pas scrapé dynamiquement pour
# l'instant) — récupère la valeur actuelle depuis le code source d'une page
# authentifiée sur stych.fr (chercher "token_csrf"). Si Stych le fait un
# jour changer, le relogin automatique cessera de fonctionner silencieusement
# jusqu'à mise à jour manuelle ici.
STYCH_CSRF_TOKEN=

# Intervalle de veille en minutes (recommandation cahier des charges : 5-15 min)
STYCH_POLL_INTERVAL_MINUTES=10
